# Cloudflare static-asset response headers (docs/web/docs-site.md). Scripts are
# held to 'self' plus each page's own inline hashes by the CSP <meta> that
# SvelteKit writes into every prerendered page; a script must pass both
# policies, so this one allows inline only to defer to that narrower one.
# 'wasm-unsafe-eval' is for Pagefind's search index. The one inline style
# allowed, by hash, is SvelteKit's route announcer's (the live region that
# reads each new page's title), which it writes as a style attribute; the
# e2e console checks fail if a SvelteKit update changes it. Nothing loads from
# another origin.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-hashes' 'sha256-S8qMpvofolR8Mpjy4kQvEm7m1q8clzU4dfDH0AmvZjo='; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
